{
  "name": "skillregistry",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "ANALYSIS_LIMIT",
      "namespace_id": "140722",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "keep_vars": true
}
